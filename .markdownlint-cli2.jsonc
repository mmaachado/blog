{
  // Comprimento de linha é preferência de edição, não qualidade do texto:
  // os posts são escritos em editor, onde a quebra manual não é natural.
  "config": {
    "MD013": false,
    // Ponto final em título é abreviação ("I.A.") ou reticência de estilo; o resto
    // da pontuação continua valendo.
    "MD026": { "punctuation": ",;:!" }
  },
  "globs": ["content/**/*.md", "*.md"]
}
